rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuth() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidId(userId);
      
      match /custom_vocab/{vocabId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(vocabId);
        allow delete: if isOwner(userId);
      }
      
      match /sync/{syncId} {
        allow read: if true;
        allow write: if isOwner(userId) && isValidId(syncId);
      }
    }

    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);
    }
  }
}
