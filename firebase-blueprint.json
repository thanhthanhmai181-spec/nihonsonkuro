{
  "entities": {
    "UserProgress": {
      "title": "UserProgress",
      "description": "User progress data, streak, xp, etc.",
      "type": "object",
      "properties": {
        "streak": { "type": "number" },
        "xp": { "type": "number" },
        "learnedWordIds": { "type": "array" },
        "favoriteWordIds": { "type": "array" },
        "quizHighScore": { "type": "number" },
        "selectedAvatarId": { "type": "string" },
        "userName": { "type": "string" },
        "lastActiveDate": { "type": "string" }
      }
    },
    "Vocabulary": {
      "title": "Vocabulary",
      "description": "Custom user vocabulary entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "word": { "type": "string" },
        "reading": { "type": "string" },
        "romaji": { "type": "string" },
        "meaning": { "type": "string" },
        "example": { "type": "string" },
        "exampleMeaning": { "type": "string" },
        "level": { "type": "string" },
        "category": { "type": "string" }
      }
    },
    "SyncStorage": {
      "title": "SyncStorage",
      "description": "User local storage data synced to cloud for multi-device support",
      "type": "object",
      "properties": {
        "data": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    },
    "Leaderboard": {
      "title": "Leaderboard",
      "description": "Public user rank and stats for hall of fame leaderboard",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "userName": { "type": "string" },
        "selectedAvatarId": { "type": "string" },
        "customAvatarUrl": { "type": "string" },
        "xp": { "type": "number" },
        "streak": { "type": "number" },
        "quizHighScore": { "type": "number" },
        "learnedWordsCount": { "type": "number" },
        "learnedGrammarCount": { "type": "number" },
        "learnedKanjiCount": { "type": "number" },
        "totalMasteredCount": { "type": "number" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProgress",
      "description": "User progress and settings documents"
    },
    "users/{userId}/custom_vocab/{vocabId}": {
      "schema": "Vocabulary",
      "description": "Custom vocabularies added by the user"
    },
    "users/{userId}/sync/{syncId}": {
      "schema": "SyncStorage",
      "description": "Synced local storage keys for progress data"
    },
    "leaderboard/{userId}": {
      "schema": "Leaderboard",
      "description": "Public leaderboard entry for hall of fame"
    }
  }
}
